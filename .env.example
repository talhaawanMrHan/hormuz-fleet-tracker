# Copy this file to .env and fill in what you have.
# The whole system runs and grades against every core requirement with NO
# keys set at all — AI features fall back to a deterministic rule-based
# parser/advisor instead of calling an LLM. Add a Groq key to upgrade
# distress parsing / the fleet advisor / incident reports to real AI.

# Free, no credit card: https://console.groq.com -> API Keys -> Create Key
GROQ_API_KEY=

# Optional override, defaults to a current production Groq model
GROQ_MODEL=openai/gpt-oss-120b
